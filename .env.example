# Genera un secreto distinto para producción, de al menos 32 caracteres.
PORTAL_SESSION_SECRET=reemplazar-con-un-secreto-largo-y-aleatorio

# Agrega o actualiza operadores con: npm run portal:hash-code
# Para usar un código existente: npm run portal:hash-code -- codigo-del-operador
# La lista admite hasta 100 operadores con correos únicos.
PORTAL_USERS="[{\"name\":\"Nombre del operador\",\"company\":\"Nombre de la empresa\",\"email\":\"operador@empresa.com\",\"codeHash\":\"scrypt\$SALT\$HASH\"}]"
